{
  "expo": {
    "name": "my-dua-collection",
    "slug": "my-dua-collection",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myduacollection",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00212E",
          "dark": {
            "backgroundColor": "#00212E"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow My Dua Collection to use the camera to scan a dua from a photo.",
          "photosPermission": "Allow My Dua Collection to read a picture of a dua from your photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow My Dua Collection to access your photos.",
          "savePhotosPermission": "Allow My Dua Collection to save dua cards to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "fb",
            "instagram",
            "instagram-stories",
            "twitter",
            "whatsapp",
            "tg",
            "fb-messenger",
            "sms"
          ],
          "android": [
            "com.facebook.katana",
            "com.instagram.android",
            "com.twitter.android",
            "com.whatsapp",
            "org.telegram.messenger",
            "com.facebook.orca"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#066653"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
